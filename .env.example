# ═══════════════════════════════════════════════════════════
# AI 智能问答平台 — 环境变量模板
# 复制为 .env 后填入实际值即可：Copy-Item .env.example .env
# ═══════════════════════════════════════════════════════════

# ── 应用基础 ────────────────────────────────────────
APP_NAME=AI 智能问答平台
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# ── SQLite 数据库 ──────────────────────────────────
# 异步驱动用 aiosqlite，路径相对项目根目录
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ── 模型配置（P0 必需）─────────────────────────────
# DeepSeek：OpenAI 兼容接口，Key 在 platform.deepseek.com 申请
DEFAULT_MODEL=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL_TIMEOUT_SECONDS=10

# ── 本地模型（Ollama / vLLM / LM Studio）────────────
# Ollama 默认 OpenAI 兼容地址；模型名用 `ollama list` 里的名称
# 本地模型免鉴权，LOCAL_MODEL_API_KEY 一般留空；首次推理较慢故超时放宽到 60s
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_NAME=qwen2.5:7b
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_TIMEOUT_SECONDS=60

# ── JWT 双 Token（P1）───────────────────────────────
# 用 openssl rand -hex 32 生成
JWT_SECRET=please_change_this_secret_key_xxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── API Key 主加密密钥（AES-256）────────────────────
# 用户自建模型的 api_key 会用该密钥加密后入库；一旦修改，旧密文将无法解密
MASTER_ENCRYPTION_KEY=please_change_this_aes_key_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ChromaDB（P2）───────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=knowledge_docs

# ── 安全 / 配额（P2）────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
DEFAULT_DAILY_TOKEN_QUOTA=100000
CONTEXT_TRUNCATE_TURNS=20

# ── 定时任务（P2）───────────────────────────────────
SOFT_DELETE_CLEANUP_DAYS=30

# ── 上传目录 ────────────────────────────────────────
UPLOAD_DIR=./uploads
